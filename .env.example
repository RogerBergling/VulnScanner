# VulnScanner configuration. Copy this file to .env and edit it.
# run.sh / run.bat load .env automatically; the values can also be exported in
# the shell or set in the Windows environment.

# --- Web server -------------------------------------------------------------
# Keep 127.0.0.1 for a single-user workstation. Use 0.0.0.0 only behind a
# firewall or reverse proxy with TLS. The Settings page stores these values in
# SQLite and mirrors them here for run.sh/run.bat; restart to apply.
VS_HOST=127.0.0.1
VS_PORT=8765
VS_LOG_LEVEL=INFO

# Built-in HTTPS with a self-signed certificate. Enabled by default for local
# use; browsers show a certificate warning and the cert/key are created under
# $VS_DATA_DIR/certs/ on first start. Set VS_SSL=false for plain HTTP, e.g. when
# a TLS-terminating reverse proxy is in front of the app. The Settings page
# stores the HTTPS choice in SQLite and mirrors it here.
VS_SSL=true

# Optional HTTP Basic authentication for the dashboard and /api endpoints.
# The Settings page stores a salted password hash in SQLite. VS_ADMIN_PASSWORD
# is a legacy/initial fallback and is migrated to the database on startup.
# Leave empty only while bound to localhost.
VS_ADMIN_USER=admin
VS_ADMIN_PASSWORD=

# --- Local data -------------------------------------------------------------
# Defaults to ./data next to the application. For any real deployment, put this
# outside the Git checkout (for example /var/lib/vulnscanner) so a git pull,
# re-clone or deployment cleanup cannot remove the database, certificates,
# credential key or backups. Use absolute paths.
# VS_DATA_DIR=/var/lib/vulnscanner
# VS_DATABASE=/var/lib/vulnscanner/vulnscanner.db

# Encryption key for stored target credentials (Fernet/AES). If unset, a key is
# generated in $VS_DATA_DIR/credential.key with mode 0600 on first use. Back up
# the key with the database: without it, saved credentials cannot be decrypted.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# VS_CREDENTIAL_KEY=

# --- External services ------------------------------------------------------
# OSV.dev package lookups, the CISA KEV catalogue and GitHub clones.
# Set to false for an air-gapped deployment; built-in checks keep working.
VS_ENABLE_EXTERNAL_APIS=true

# --- Authenticated SSH host-key verification --------------------------------
# Optional known_hosts file. When set, SSH host keys are verified before
# credentials are sent. When empty, the fingerprint is logged but not enforced
# (compatible with existing lab deployments).
# VS_SSH_KNOWN_HOSTS=/var/lib/vulnscanner/known_hosts

# --- Optional command-line tools -------------------------------------------
# Leave empty to search PATH. Absolute paths are useful for service installs.
# Settings -> Optional command-line tools stores paths in SQLite and mirrors
# them here; database backups include them.
VS_NMAP_PATH=
VS_NUCLEI_PATH=
VS_TESTSSL_PATH=
VS_TRIVY_PATH=
VS_SUBFINDER_PATH=
VS_OSV_SCANNER_PATH=
VS_GITLEAKS_PATH=
VS_SEMGREP_PATH=
VS_GIT_PATH=

# --- Subdomain wordlist -----------------------------------------------------
# Editable default: $VS_DATA_DIR/wordlists/subdomains.txt
# Settings can load the standard SecLists DNS list into that file.
# VS_SUBFINDER_WORDLIST=
VS_SECLISTS_SUBDOMAIN_URL=https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/DNS/subdomains-top1million-5000.txt

# --- Scan guardrails --------------------------------------------------------
VS_MAX_REPO_BYTES=536870912
VS_MAX_SOURCE_FILE_BYTES=1048576
VS_MAX_SCAN_FILES=20000
VS_MAX_CIDR_HOSTS=256
VS_AGENT_JOB_TIMEOUT=3600
# Parallel server-side scans (1-32). Agent jobs do not consume a worker.
VS_SCAN_WORKERS=4
